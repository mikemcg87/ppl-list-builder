# ScrapeCreators API Key (for Facebook Ads)
SCRAPECREATORS_API_KEY=your_scrapecreators_key_here

# SerpApi API Key (rate-constrained; avoid for new niche work unless explicitly opted in)
SERPAPI_API_KEY=your_serpapi_key_here

# Companies House API Key (for UK director lookup) — free at
# https://developer.company-information.service.gov.uk/
COMPANIES_HOUSE_API_KEY=your_companies_house_key_here

# FCA Financial Services Register API (mortgage broker source builder) — free at
# https://register.fca.org.uk/Developer/s/ — rate limited to 10 requests per 10 seconds.
# The email is the account email you registered with; both are sent as auth headers.
FCA_API_EMAIL=your_fca_developer_email_here
FCA_API_KEY=your_fca_api_key_here

# Hunter.io API key — rate-constrained. Use only for PLATINUM rows, capped tests first.
# Free tier: 25 searches/month. https://hunter.io/api-keys
HUNTER_API_KEY=your_hunter_key_here

# Brave Search API key — default for domain discovery.
# Free tier: 2,000 queries/month. https://api.search.brave.com/
BRAVE_API_KEY=your_brave_key_here

# Optional GHL/HighLevel import settings.
# Leave unset unless you explicitly want to push reviewed rows into a CRM.
GHL_PRIVATE_TOKEN=your_ghl_private_token_here
GHL_LOCATION_ID=your_ghl_location_id_here
GHL_API_BASE=https://services.leadconnectorhq.com
GHL_API_VERSION=2021-07-28
GHL_PIPELINE_ID=your_pipeline_id_here
GHL_TO_SEND_STAGE_ID=your_stage_id_here
GHL_COHORT_TAG=cohort:example-YYYY-MM
GHL_PIPELINE_NAME=Example Outreach

# Optional Notion export settings.
NOTION_TOKEN=your_notion_token_here
NOTION_PARENT_PAGE_QUERY=Outreach
NOTION_SECTION_TITLE=Prospect Intelligence Review
NOTION_DATABASE_TITLE=Installer Prospects
